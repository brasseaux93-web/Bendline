# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL (used for Stripe redirects, Open Graph, sitemap). Must be the public https URL in production.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Stripe Billing & Entitlements (configure real Stripe Price IDs per environment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PASS_3M=
STRIPE_PRICE_ID_MONTHLY=

# Optional AI Explanations
OPENAI_API_KEY=

# Set to 1 on production builds to fail fast when any required variable above is missing.
# (Vercel production builds enable this automatically via VERCEL_ENV.)
BENDLINE_STRICT_ENV=
